# Copy this file to .env for local development. Do not commit .env.
# Set the same names in the Vercel project environment for production.

# Local development
DEBUG=True
SECRET_KEY=replace-with-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Production example (set in Vercel, with DEBUG=False):
# DEBUG=False
# SECRET_KEY=replace-with-a-different-long-random-string
# ALLOWED_HOSTS=your-domain.com,.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://your-project.vercel.app
# SECURE_SSL_REDIRECT=True

# Outgoing mail. Leave blank until you are ready to send messages.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
PERSONAL_EMAIL=
